PORT=8081
ENVIRONMENT=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/users?sslmode=disable
ITCHI_SECRET_KEY=
ITCHI_ENCRYPTION_KEY=
INTERNAL_API_KEY=
INTERNAL_API_KEY_REQUIRED=true
NOTIFICATION_API_URL=http://localhost:8087
PAYMENTS_API_URL=http://localhost:8089
# Optional: Google sign-in (routes return 503 while client id/secret are empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8081/auth/google/callback
# Optional: LinkedIn sign-in, OpenID Connect product (routes return 503 while client id/secret are empty)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL=http://localhost:8081/auth/linkedin/callback
FRONTEND_URL=http://localhost:3000
# Optional: Mailgun password reset mails (disabled while API key or domain is empty)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Default: 9itchi <no-reply@MAILGUN_DOMAIN>
MAILGUN_FROM_EMAIL=
# Empty = US region; https://api.eu.mailgun.net for EU
MAILGUN_API_BASE=
MAILGUN_RATE_LIMIT=10
# Optional: creates the first admin at startup when no admin exists
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: user.registered is published to RabbitMQ when set (amqp://guest:guest@localhost:5672/ locally); logged otherwise
RABBITMQ_URL=
